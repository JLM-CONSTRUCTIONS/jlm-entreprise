<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JLM Constructions - Maçonnerie</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #0b132b;
      color: #ffffff;
    }

    header {
      background: linear-gradient(135deg, #0b132b, #1c2541);
      padding: 40px 20px;
      text-align: center;
    }

    header img {
      max-width: 220px;
      margin-bottom: 20px;
    }

    header h1 {
      margin: 0;
      font-size: 3rem;
      color: #4ea8de;
    }

    header h2 {
      margin-top: 10px;
      font-weight: normal;
      color: #f77f00;
    }

    section {
      padding: 60px 20px;
      max-width: 1100px;
      margin: auto;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: #1c2541;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }

    .card h3 {
      color: #f77f00;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }

    .gallery img {
      width: 100%;
      border-radius: 12px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.4);
      opacity: 0;
      transform: translateY(40px);
      transition: all 0.8s ease;
    }

    .gallery img.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .contact {
      background: #1c2541;
      border-radius: 12px;
      padding: 40px;
      text-align: center;
    }

    footer {
      background: #0b132b;
      text-align: center;
      padding: 20px;
      font-size: 0.9rem;
      color: #cccccc;
    }

    a {
      color: #4ea8de;
      text-decoration: none;
    }
  </style>
</head>

<body>

<header>
  <a href="https://jlm-entreprise.fr" target="_blank">
    <img src="logo-jlm.png" alt="Logo JLM Constructions">
  </a>
  <h1>JLM CONSTRUCTIONS</h1>
  <h2>Maçonnerie Générale – Gros œuvre & Rénovation</h2><p style="margin-top:30px;">
  <a href="mailto:renaldosutajlm@gmail.com?subject=Demande%20de%20devis"
     style="
       background:#f77f00;
       color:#ffffff;
       padding:15px 35px;
       border-radius:40px;
       font-size:1.1rem;
       font-weight:bold;
       display:inline-block;
     ">
     📄 Demander un devis
  </a>
</p>

</header>
<section>
  <h2>À propos</h2>
  <p>
    JLM Constructions est une entreprise spécialisée dans la maçonnerie générale.
    Nous réalisons vos projets avec sérieux, solidité et savoir-faire.
  </p>

  <!-- 👉 COLLER LE BOUTON ICI -->
</section>


<section>
  <h2>Nos services</h2>
  <div class="services">
    <div class="card">
      <h3>Maçonnerie générale</h3>
      <p>Murs, fondations, dalles béton.</p>
    </div>
    <div class="card">
      <h3>Gros œuvre</h3>
      <p>Construction neuve et extensions.</p>
    </div>
    <div class="card">
      <h3>Rénovation</h3>
      <p>Travaux de reprise et rénovation.</p>
    </div>
    <div class="card">
      <h3>Murs & clôtures</h3>
      <p>Murs de soutènement et extérieurs.</p>
    </div>
  </div>
</section>

<section>
  <h2>Nos réalisations</h2>
  <p>Quelques chantiers réalisés par JLM Constructions.</p>

 <div class="gallery" id="gallery"></div>

<script>
  const totalPhotos = 86;
  const gallery = document.getElementById("gallery");

  for (let i = 1; i <= totalPhotos; i++) {
    const img = document.createElement("img");
    img.src = `galerie/photo (${i}).jpg`;
    img.alt = "Chantier JLM";
    gallery.appendChild(img);
  }
</script>

  </div>
</section>

<section>
  <h2>Contact</h2>
  <div class="contact">
    <p><strong>SUTA Rénaldo</strong></p>
    <p>📞 GSM : <a href="tel:730797">73.07.97</a></p>
    <p>✉️ Mail : <a href="mailto:renaldosutajlm@gmail.com">renaldosutajlm@gmail.com</a></p>
  </div>
</section>

<footer>
  <p>© 2026 JLM Constructions – Tous droits réservés</p>
</footer>

<script>
  const images = document.querySelectorAll('.gallery img');
  const revealOnScroll = () => {
    images.forEach(img => {
      const rect = img.getBoundingClientRect();
      if (rect.top < window.innerHeight - 50) {
        img.classList.add('visible');
      }
    });
  };
  window.addEventListener('scroll', revealOnScroll);
  revealOnScroll();
</script>

</body>
</html>
